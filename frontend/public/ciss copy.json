{
  "items": [
    { "id": 1, "text": "Lepiej planuję swój czas", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 2, "text": "Koncentruję się na problemie i zastanawiam się, jak mogę go rozwiązać", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 3, "text": "Myślę o czasach gdy było mi lepiej", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 4, "text": "Staram się przebywać z innymi ludźmi", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 5, "text": "Oskarżam się o zwlekanie", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 6, "text": "Robię to, co uważam za najlepsze", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 7, "text": "Jestem skupiony(a) na swoich dolegliwościach fizycznych", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 8, "text": "Winię siebie, że wpadłem(am) w taką sytuację", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 9, "text": "Włóczę się po sklepach", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 10, "text": "Ustalam, co w danej sytuacji jest najważniejsze", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 11, "text": "Staram się zasnąć", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 12, "text": "Objadam się ulubioną potrawą", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 13, "text": "Niepokoję się, że sobie nie poradzę", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 14, "text": "Staję się bardzo napięty(a)", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 15, "text": "Myślę o tym, jak rozwiązywałem(am) podobne problemy w przeszłości", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 16, "text": "Wmawiam sobie, że to w rzeczywistości nie dzieje się mnie", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 17, "text": "Winię siebie, że zbyt się tym przejmuję", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 18, "text": "Idę coś zjeść na mieście", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 19, "text": "Staję się bardzo przygnębiony(a)", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 20, "text": "Kupuję sobie coś", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 21, "text": "Wyznaczam sobie kierunek działania i postępuję zgodnie z nim", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 22, "text": "Obwiniam siebie za to, że nie wiem co zrobić", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 23, "text": "Idę się zabawić", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 24, "text": "Staram się zrozumieć sytuację", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 25, "text": "\"Zastygam w bezruchu\" i nie wiem co zrobić", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 26, "text": "Podejmuję natychmiast właściwe działanie", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 27, "text": "Analizuję sytuację i uczę się na własnych błędach", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 28, "text": "Żałuję, że nie mogę zmienić tego co się stało, lub tego, co odczuwałem(am) w związku z tym", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 29, "text": "Odwiedzam przyjaciela", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 30, "text": "Martwię się, jak sobie z tym poradzę", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 31, "text": "Spędzam czas z bliską osobą", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 32, "text": "Wychodzę na spacer", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 33, "text": "Wmawiam sobie, że to się nigdy więcej nie powtórzy", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 34, "text": "Skupiam się na swoich ogólnych brakach", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 35, "text": "Rozmawiam z kimś, kogo rady sobie cenię", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 36, "text": "Analizuję problem zanim zacznę działać", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 37, "text": "Dzwonię do kolegi lub koleżanki", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 38, "text": "Wpadam w złość", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 39, "text": "Zmieniam kolejność spraw do załatwienia", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 40, "text": "Oglądam film", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 41, "text": "Dążę do kontrolowania sytuacji", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 42, "text": "Podejmuję dodatkowy wysiłek, aby załatwić sprawę", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 43, "text": "Podchodzę do problemu z różnych stron", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 44, "text": "\"Robię sobie wolne\", by uciec od problemu", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 45, "text": "Wyładowuję się na innych", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 46, "text": "Wykorzystuję sytuację, aby udowodnić, że potrafię tego dokonać", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 47, "text": "Staram się tak zorganizować sprawy, aby zapanować nad sytuacją", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] },
    { "id": 48, "text": "Oglądam telewizję", "options": ["Nigdy", "Bardzo rzadko", "Czasami", "Często", "Bardzo często"] }
  ]
}
